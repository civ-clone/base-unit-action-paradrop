{
  "name": "@civ-clone/base-unit-action-paradrop",
  "version": "0.0.0",
  "description": "The Paradrop unit action: a unit drops onto a land tile within a range, capturing an empty city of another player there, and is marked Paradropped until its player's next turn; with criteria for offering it and the rule that clears the mark.",
  "repository": "git@github.com:civ-clone/base-unit-action-paradrop.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-terrain": "^0.1.4",
    "@civ-clone/core-world-generator": "^0.1.7",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-city": "^0.1.24",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-unit-improvement": "^0.1.3",
    "@civ-clone/core-world": "^0.1.24"
  }
}
